# Runner config for run_inventory.sh — copy to conf/.env and edit.
#   cp conf/.env.example conf/.env

# Optional AWS profile to scan (single account, per project design).
# Empty or omitted uses the AWS CLI [default] profile.
AWS_PROFILE=

# Optional: limit to one region (omit/empty = all regions the service supports).
AWS_REGION=

# How many scanner scripts to run at once. 2 is a safe default; higher =
# faster but more API load / throttling risk.
PARALLEL=2

# Optional: comma-separated script names to run (without path). Empty = all
# scripts in inventory/. Example: get_ec2_inventory.py,get_s3_inventory.py
ONLY=

# Optional: comma-separated script names to skip. Example:
# get_cost_inventory.py,get_health_inventory.py
SKIP=
